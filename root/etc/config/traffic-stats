# Configuration of the traffic statistics collector
#
# The collector reads the traffic that crosses the router with a read only
# packet socket. No firewall rule, route or DNS setting is ever modified.
#
# lan_interfaces   interfaces that face the local network, the traffic of
#                  every device is attributed here
# wan_interfaces   interfaces that face the internet, they provide the
#                  total traffic volume and the destination statistics
# stats_iface      interface whose counters are shown as the WAN total
# sample_interval  length of a sampling interval in seconds
# dns_ttl          how long a learned domain name is remembered, in seconds
# count_internal   also count the traffic between the local devices
# history_days     number of days the daily statistics are kept
#
# The names of the devices are taken from the DHCP leases of the router and
# from the static DHCP entries in /etc/config/dhcp.

config global 'global'
	list lan_interfaces 'br-lan'
	list wan_interfaces 'wan'
	option stats_iface 'pppoe-wan'
	option sample_interval '1'
	option dns_ttl '86400'
	option count_internal '0'
	option history_days '400'
