#!/bin/sh /etc/rc.common
# procd service for the traffic statistics collector

USE_PROCD=1
START=95
STOP=10

PROG=/usr/libexec/traffic-stats/traffic-stats

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" --foreground
	procd_set_param file /etc/config/traffic-stats
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "traffic-stats"
}
