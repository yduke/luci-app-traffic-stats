{
	"luci-app-traffic-stats": {
		"description": "Grant access to the traffic statistics",
		"read": {
			"ubus": {
				"luci.trafficstats": [ "overview", "devices", "destinations", "history", "config" ],
				"network.device": [ "status" ]
			},
			"uci": [ "traffic-stats" ]
		},
		"write": {
			"ubus": {
				"luci.trafficstats": [ "setconfig", "restart" ]
			},
			"uci": [ "traffic-stats" ]
		}
	}
}
